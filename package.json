{
  "name": "spock-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @spock/simple dev",
    "dev:docs": "pnpm --filter @spock/docs dev",
    "playground": "node scripts/playground.mjs",
    "dev:playground": "pnpm --dir playground dev",
    "flows": "pnpm --filter @spock/simple flows",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint router toolbar templates"
  },
  "devDependencies": {
    "oxlint": "^1.90.0"
  }
}
